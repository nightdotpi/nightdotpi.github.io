# ==============================================================================
# Night Frontend Configuration - EXAMPLE
# Copy to .env.development / .env.production as needed. Do not commit real .env*
# ==============================================================================

# Backend API (must include /api suffix if your backend mounts under /api)
VITE_API_URL=http://localhost:5000/api

# Public frontend / Pi app URL
VITE_PI_APP_URL=http://localhost:5173

# Pi Network App Identity (from Pi Developer Portal)
VITE_PI_APP_ID=your-pi-app-id
VITE_PI_CLIENT_ID=your-pi-client-id

# Pi Network Mode: true = Testnet/Sandbox, false = Mainnet
VITE_PI_SANDBOX=false

# Payment limits (in Pi)
VITE_DEFAULT_PI_AMOUNT=0.01
VITE_MIN_PI_AMOUNT=0.001
VITE_MAX_PI_AMOUNT=100
