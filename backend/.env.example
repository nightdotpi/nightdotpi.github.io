# ==============================================================================
# Night Backend Configuration - EXAMPLE
# Copy this file to .env and fill in real values. NEVER commit .env
# ==============================================================================

# --- [1] Server ---
PORT=5000
NODE_ENV=development
PUBLIC_API_URL=http://localhost:5000

# --- [2] Security & Authentication (JWT) ---
# Generate a long random string, e.g. openssl rand -hex 32
JWT_SECRET=replace_with_long_random_secret_at_least_32_chars
TOKEN_EXPIRATION=7d

# --- [3] Admin Access Control ---
# Generate another long random string
ADMIN_SECRET_KEY=replace_with_another_long_random_secret

# --- [4] Pi Network API Integration ---
# Get from Pi Developer Portal
PI_API_KEY=replace_with_your_pi_api_key
PI_APP_ID=your-pi-app-id
# Set to true only if you want to enforce accessToken verification
PI_REQUIRE_ACCESS_TOKEN=false

# --- [5] Database (PostgreSQL / Neon / etc.) ---
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# --- [6] CORS & Frontend ---
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://nightdotpi.github.io

# ==============================================================================
# SECURITY: Rotate all secrets if this file or any .env was ever committed/pushed.
# ==============================================================================
